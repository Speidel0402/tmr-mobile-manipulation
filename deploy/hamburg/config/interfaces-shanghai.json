{
  "schema_version": 1,
  "profile_name": "hamburg-native-action-defaults",
  "gripper": {
    "left_topic": "/left/gripper/gripper_client/target_gripper_width_percent",
    "right_topic": "/right/gripper/gripper_client/target_gripper_width_percent",
    "message_type": "std_msgs/msg/Float32",
    "field": "data",
    "unit": "normalized_opening_width",
    "minimum": 0.0,
    "maximum": 1.0,
    "open": 0.8,
    "closed": 0.0,
    "startup_left": 0.8,
    "startup_right": 0.0,
    "legacy_action_conversion": "width_topic_value = 0.8 - legacy_gripper_action_position",
    "provenance": "Shanghai startup publishes std_msgs/msg/Float32 with 0.8 to open; the validated action API uses the opposite 0.0=open, 0.8=closed convention."
  },
  "spine": {
    "topic": "/spine/target_height",
    "message_type": "std_msgs/msg/Float32",
    "field": "data",
    "unit": "metre",
    "absolute": true,
    "minimum_m": 0.0,
    "maximum_m": 0.8,
    "home_m": 0.7,
    "provenance": "Hamburg organizer confirms MoveAbsolute plus get_position. Shanghai source establishes goal.position, velocity, acceleration, deceleration and 0.7 m home target.",
    "interface": "action",
    "action_name": "/franka_spine_node/move_absolute",
    "action_type": "franka_spine_msgs/action/MoveAbsolute",
    "position_service": "/franka_spine_node/get_position",
    "position_service_type": "franka_spine_msgs/srv/GetPosition"
  },
  "arm_command": {
    "semantics": "relative_direction_mapped_gello",
    "direction": [-1, -1, 1, 1, 1, 1, -1],
    "requires_pre_activation_neutral_sample": true,
    "activation_sync_duration_s": 1.0,
    "activation_sync_maximum_drift_rad": 0.05,
    "stale_input_behavior": "controller zeroes torque and stops when the GELLO stream becomes stale",
    "provenance": "Hamburg trial 2 confirmed that /{left,right}/gello/joint_states is interpreted relative to robot and GELLO samples captured at controller activation, with joints 1, 2 and 7 direction-reversed."
  },
  "arm_motion": {
    "posture_joint_velocity_rad_s": 0.06,
    "maximum_following_error_rad": 0.24,
    "following_error_pause_rad": 0.20,
    "following_error_resume_rad": 0.14,
    "following_error_recovery_timeout_s": 5.0,
    "joint_feedback_stale_timeout_s": 1.0,
    "provenance": "Hamburg trials showed a 0.1603 rad tracking transient and process-local callback age peaks of 0.501-0.613 s while all measured streams remained healthy. The normal ramp is retained; arm publication is isolated from input callback servicing, and the bounded 1.0 s feedback-age guard leaves measured scheduling margin while still aborting a real stale stream."
  },
  "environment_overrides": {
    "TMR_HAMBURG_LEFT_GRIPPER_TOPIC": "gripper.left_topic",
    "TMR_HAMBURG_RIGHT_GRIPPER_TOPIC": "gripper.right_topic",
    "TMR_HAMBURG_GRIPPER_MESSAGE_TYPE": "gripper.message_type",
    "TMR_HAMBURG_GRIPPER_FIELD": "gripper.field",
    "TMR_HAMBURG_GRIPPER_OPEN": "gripper.open",
    "TMR_HAMBURG_GRIPPER_CLOSED": "gripper.closed",
    "TMR_HAMBURG_SPINE_TOPIC": "spine.topic",
    "TMR_HAMBURG_SPINE_MESSAGE_TYPE": "spine.message_type",
    "TMR_HAMBURG_SPINE_FIELD": "spine.field",
    "TMR_HAMBURG_SPINE_HOME_M": "spine.home_m",
    "TMR_HAMBURG_SPINE_INTERFACE": "spine.interface",
    "TMR_HAMBURG_SPINE_ACTION_NAME": "spine.action_name",
    "TMR_HAMBURG_SPINE_POSITION_SERVICE": "spine.position_service",
    "TMR_HAMBURG_ARM_POSTURE_VELOCITY_RAD_S": "arm_motion.posture_joint_velocity_rad_s",
    "TMR_HAMBURG_ARM_MAXIMUM_FOLLOWING_ERROR_RAD": "arm_motion.maximum_following_error_rad",
    "TMR_HAMBURG_ARM_FOLLOWING_ERROR_PAUSE_RAD": "arm_motion.following_error_pause_rad",
    "TMR_HAMBURG_ARM_FOLLOWING_ERROR_RESUME_RAD": "arm_motion.following_error_resume_rad",
    "TMR_HAMBURG_ARM_FOLLOWING_ERROR_RECOVERY_TIMEOUT_S": "arm_motion.following_error_recovery_timeout_s",
    "TMR_HAMBURG_ARM_JOINT_FEEDBACK_STALE_TIMEOUT_S": "arm_motion.joint_feedback_stale_timeout_s",
    "TMR_HAMBURG_ARM_COMMAND_SEMANTICS": "arm_command.semantics",
    "TMR_HAMBURG_ARM_ACTIVATION_SYNC_DURATION_S": "arm_command.activation_sync_duration_s",
    "TMR_HAMBURG_ARM_ACTIVATION_SYNC_MAXIMUM_DRIFT_RAD": "arm_command.activation_sync_maximum_drift_rad",
    "TMR_HAMBURG_HEAD_CAMERA_WIDTH": "head_camera.width",
    "TMR_HAMBURG_HEAD_CAMERA_HEIGHT": "head_camera.height"
  },
  "head_camera": {
    "width": 640,
    "height": 360,
    "zed_pub_resolution": "CUSTOM",
    "zed_pub_downscale_factor": 2.0,
    "provenance": "Hamburg ZED HD720 output is 1280x720 by default; organizer preflight confirmed 640x360 after downscaling. Current Stereolabs ROS 2 wrapper applies general.pub_downscale_factor only when general.pub_resolution is CUSTOM."
  }
}
