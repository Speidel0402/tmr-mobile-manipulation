{
  "schema_version": 1,
  "profile_name": "hamburg-native-action-defaults",
  "gripper": {
    "left_topic": "/left/gripper/gripper_client/target_gripper_width_percent",
    "right_topic": "/right/gripper/gripper_client/target_gripper_width_percent",
    "message_type": "std_msgs/msg/Float32",
    "field": "data",
    "unit": "normalized_opening_width",
    "minimum": 0.0,
    "maximum": 1.0,
    "open": 0.8,
    "closed": 0.0,
    "startup_left": 0.8,
    "startup_right": 0.0,
    "legacy_action_conversion": "width_topic_value = 0.8 - legacy_gripper_action_position",
    "provenance": "Shanghai startup publishes std_msgs/msg/Float32 with 0.8 to open; the validated action API uses the opposite 0.0=open, 0.8=closed convention."
  },
  "spine": {
    "topic": "/spine/target_height",
    "message_type": "std_msgs/msg/Float32",
    "field": "data",
    "unit": "metre",
    "absolute": true,
    "minimum_m": 0.0,
    "maximum_m": 0.8,
    "home_m": 0.7,
    "provenance": "Hamburg organizer confirms MoveAbsolute plus get_position. Shanghai source establishes goal.position, velocity, acceleration, deceleration and 0.7 m home target.",
    "interface": "action",
    "action_name": "/franka_spine_node/move_absolute",
    "action_type": "franka_spine_msgs/action/MoveAbsolute",
    "position_service": "/franka_spine_node/get_position",
    "position_service_type": "franka_spine_msgs/srv/GetPosition"
  },
  "environment_overrides": {
    "TMR_HAMBURG_LEFT_GRIPPER_TOPIC": "gripper.left_topic",
    "TMR_HAMBURG_RIGHT_GRIPPER_TOPIC": "gripper.right_topic",
    "TMR_HAMBURG_GRIPPER_MESSAGE_TYPE": "gripper.message_type",
    "TMR_HAMBURG_GRIPPER_FIELD": "gripper.field",
    "TMR_HAMBURG_GRIPPER_OPEN": "gripper.open",
    "TMR_HAMBURG_GRIPPER_CLOSED": "gripper.closed",
    "TMR_HAMBURG_SPINE_TOPIC": "spine.topic",
    "TMR_HAMBURG_SPINE_MESSAGE_TYPE": "spine.message_type",
    "TMR_HAMBURG_SPINE_FIELD": "spine.field",
    "TMR_HAMBURG_SPINE_HOME_M": "spine.home_m",
    "TMR_HAMBURG_SPINE_INTERFACE": "spine.interface",
    "TMR_HAMBURG_SPINE_ACTION_NAME": "spine.action_name",
    "TMR_HAMBURG_SPINE_POSITION_SERVICE": "spine.position_service",
    "TMR_HAMBURG_HEAD_CAMERA_WIDTH": "head_camera.width",
    "TMR_HAMBURG_HEAD_CAMERA_HEIGHT": "head_camera.height"
  },
  "head_camera": {
    "width": 640,
    "height": 360,
    "zed_pub_resolution": "CUSTOM",
    "zed_pub_downscale_factor": 2.0,
    "provenance": "Hamburg ZED HD720 output is 1280x720 by default; organizer preflight confirmed 640x360 after downscaling. Current Stereolabs ROS 2 wrapper applies general.pub_downscale_factor only when general.pub_resolution is CUSTOM."
  }
}
